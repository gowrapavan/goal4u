# ═══ DATA SERVICE (server-side only: nothing here reaches the browser) ═════════
# GOAL4U_DATA_URL = your gowra-api service address on Render + /goal4u-data:
#   Render dashboard → gowra-api → the URL under its name (https://<name>.onrender.com)  →  https://<name>.onrender.com/goal4u-data
# Check it: open <that>/goal4u-data/data/2026-2027/PL/matches in a browser — you should see JSON.
# Empty = read GitHub directly (works, but GitHub limits and caches harder).
# (The older names VITE_GOAL4U_DATA_URL / GOAL4U_DATA_BASE still work; rename them — a VITE_ name is meant for the browser.)

# ═══ ACCESS TOKEN (required: gowra-api answers 401 without it) ═════════════════
# GOAL4U_TOKEN is the token your gowra-api expects. The SERVER sends it (Authorization: Bearer, and ?token= for pictures);
# the browser never sees it: pictures reach the page through this site's own /api/data/img/… and the build FAILS if the token or the
# data-service address ever ends up in the browser files. Put the REAL value only in .env (never committed) and in Netlify →
# Environment variables. Leave it EMPTY here. Do NOT name it VITE_… (the old name VITE_GOAL4U_TOKEN is still read, with a warning).
GOAL4U_TOKEN=""

# ═══ LOCAL TESTING (copy to .env, then `npm run dev` on port 3000) ═══════════════
# gowra-api running locally on port 8080:
GOAL4U_DATA_URL="http://localhost:8080/goal4u-data"
# News page. Free key: https://newsapi.org → Get API key. (Free plan: development use, articles ~24 h late.)
NEWSAPI_KEY=""
# Leave APP_URL unset while testing (otherwise IndexNow reports your real domain from your laptop).

# ═══ PRODUCTION: Netlify → Site configuration → Environment variables ═══════════
# There is NO other server to host: the backend (/api/*) is netlify/functions/api.ts.
# GOAL4U_DATA_URL=https://<gowra-api>.onrender.com/goal4u-data   # the PUBLIC address, never localhost
# GOAL4U_TOKEN=<your gowra-api token>                              # build (sitemap data) + functions (data, pictures). Never in the browser.
# NEWSAPI_KEY=...                                                  # newsapi.org account page
# BUILD_HOOK_URL=...                                               # Netlify → Build & deploy → Build hooks → Add build hook → copy the URL
# APP_URL=https://goal4u.netlify.app                               # optional but recommended: your Netlify address or own domain; it is also the one site allowed to call /api from a browser
# VITE_CONTACT_EMAIL=you@example.com                               # optional: shown on /contact (this one IS public on purpose)
# ALLOWED_ORIGINS=https://other-site.example                       # optional: extra websites allowed to call /api from a browser (default: none)
# ADMIN_TOKEN=...                                                  # only for POST /api/indexnow/submit (server.ts). REQUIRED in production there; no default token exists.
# Only if the function log shows "[koora-live] ... HTTP 403": KOORA_API / S365_ALLSCORES_URL = a relay you control.

# ═══ SEARCH-ENGINE VERIFICATION (optional; production, Netlify environment) ═════════
# GOOGLE_SITE_VERIFICATION=<token from Search Console → "HTML tag" method: the content="…" value only>
# BING_SITE_VERIFICATION=<token from Bing Webmaster Tools → "HTML Meta Tag": the msvalidate.01 content value only>
# They are written as <meta> tags on every page. (A verification FILE works too: put google<token>.html / BingSiteAuth.xml in public/.)

# ═══ API ACCESS ═══════════════════════════════════════════════════════════════
# By default /api/* answers only the site's own pages: opening an /api address in the browser, curl and plain scripts get 403.
# Set to 1 ONLY while you debug an API address by hand in the browser (never in production).
# API_ALLOW_DIRECT=1

# ── Secret stream page (optional; src/streams) ───────────────────────────────────────────────
# Off by default: without STREAMS_PAGE=1 the page is not in the build and /api/streams answers 404.
# Set these in Netlify (Site settings → Environment variables) and redeploy: the page is compiled in at build time.
# STREAMS_PAGE=1
# STREAMS_PATH=desk-7k2x        # the page address (default "streams"); pick something unguessable
# STREAMS_KEY=                  # optional access key, 8+ characters; the page asks for it and the API answers 401 without it
# STREAMS_FILES=                # leave unset: EVERY .json in stream-data/ is shown, new files appear by themselves. Set a comma list only to show just those.
# STREAMS_EXCLUDE=hesgoal       # optional: hide some files when everything is shown
